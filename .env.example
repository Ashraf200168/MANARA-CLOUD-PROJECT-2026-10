# Browser-safe values used in frontend/cloud-config.js
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only values. Never put either one in frontend/ or commit it.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
ALLOWED_ORIGINS=https://YOUR-CLOUDFLARE-PAGES-DOMAIN.pages.dev

# Used only by migration/import-supabase.mjs on your trusted computer.
MANARA_EXPORT_DIR=./cloud-export-YYYYMMDD-HHMMSS
